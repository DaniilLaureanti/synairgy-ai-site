# Runtime only. Copy to an ignored env file or use a platform secret store.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GOOGLE_PLACES_API_KEY=
ADMIN_TOKEN=
# Optional: leave blank to use Render's HTTPS URL (or loopback locally).
PUBLIC_BASE_URL=
# DATA_DIR must be a persistent directory outside public web hosting.
DATA_DIR=
OUTREACH_ENABLED=0
PORTFOLIO_ENABLED=1
AUTO_APPROVE_OUTREACH=0
DAILY_SEND_LIMIT=20
DAILY_AI_CALL_LIMIT=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_POSTAL_ADDRESS=
# Prefer an rk_test_ restricted key in an isolated sandbox. Never commit it.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=0
# Owner console. No OpenAI, SMTP or Stripe configuration is needed to open it.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
# Optional after `telegram-pair`; explicit ID overrides the locally paired owner.
TELEGRAM_OWNER_ID=
# Daily report time in Europe/Berlin; weekly report Monday at 09:00.
TELEGRAM_REPORT_HOUR=19
# Legacy integrations (optional; not used by the v2 core):
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
TELEGRAM_CHAT_ID=
